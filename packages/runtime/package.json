{
  "name": "@rmmz-lib/runtime",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "RPG Maker MZ runtime bootstrap for bundled hosts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@rmmz-lib/core": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  }
}
