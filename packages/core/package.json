{
  "name": "@rmmz-lib/core",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "A simple example library built by tsdown",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./global-types": "./src/global-types.d.ts"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "libs"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@rmmz-lib/database-types": "workspace:*",
    "localforage": "catalog:",
    "pako": "catalog:",
    "pixi.js": "catalog:"
  },
  "devDependencies": {
    "@types/nw.js": "catalog:types",
    "@types/pako": "catalog:types"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./global-types": "./dist/global-types.d.ts"
    }
  }
}
