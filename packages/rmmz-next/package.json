{
  "name": "rmmz-next",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "Game runtime, brand new JGSS core and Vite tooling for RPG Maker MZ projects, with TypeScript support",
  "exports": {
    ".": "./src/core/index.ts",
    "./database-types": "./src/database-types/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./vite": "./src/vite/index.ts",
    "./package.json": "./package.json",
    "./client": {
      "types": "./src/vite/client.d.ts"
    },
    "./types": {
      "types": "./src/core/types.d.ts"
    },
    "./globals": {
      "types": "./src/core/globals.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "rmmz-next": "./bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "vite": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "cac": "catalog:",
    "fflate": "catalog:",
    "localforage": "catalog:",
    "pixi.js": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "tsdown": "catalog:build",
    "typescript": "catalog:dev",
    "vite": "catalog:dev"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./database-types": "./dist/database-types.js",
      "./runtime": "./dist/runtime.js",
      "./vite": "./dist/vite.js",
      "./package.json": "./package.json",
      "./client": {
        "types": "./dist/vite/client.d.ts"
      },
      "./types": {
        "types": "./dist/types.d.ts"
      },
      "./globals": {
        "types": "./dist/globals.d.ts"
      }
    }
  }
}
