{
  "name": "rmmz-lib",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "A simple example library built by tsdown",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./types": "./dist/types.d.ts"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/nw.js": "catalog:types",
    "tsdown": "catalog:build",
    "typescript": "catalog:dev",
    "vite": "catalog:dev"
  },
  "dependencies": {
    "pixi.js": "7.4.3",
    "@rmmz-lib/database-types": "workspace:*"
  }
}
