{
  "compilerOptions": {
    "target": "es2021",
    "lib": [
      "DOM",
      "DOM.AsyncIterable",
      "DOM.Iterable",
      "ES2021"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "vite/client",
      "node",
      "rmmz-next/client",
      "rmmz-next/types",
      "rmmz-next/globals"
    ],
    "allowJs": true,
    "strict": true,
    "strictNullChecks": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "js/main.ts",
    "js/plugins"
  ]
}
