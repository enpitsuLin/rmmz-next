{
  "compilerOptions": {
    "target": "es2021",
    "lib": [
      "DOM",
      "DOM.AsyncIterable",
      "DOM.Iterable",
      "ES2021"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "vite/client",
      "vite-plugin-rmmz/client",
      "@rmmz-lib/core/global-types",
      "nw.js"
    ],
    "allowJs": true,
    "strict": true,
    "strictNullChecks": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}
